local SOURCE_BLOB = "e39d8a19a7e5481d55fce538f9059c86cd28650f"
local SOURCE_URL = "https://api.github.com/repositories/1397598812/git/blobs/" .. SOURCE_BLOB
local BRAND = "Toffy"
local PNG_PREFIX = "toffy-mascot-7f0df201c1ac-"
local ART_ASPECT = 210 / 420

local function decodeBase64(encoded)
    local encoding = game:GetService("EncodingService")
    return buffer.tostring(encoding:Base64Decode(buffer.fromstring((encoded:gsub("%s+", "")))))
end

local function fetchSource()
    local body = game:HttpGet(SOURCE_URL)
    local blob = game:GetService("HttpService"):JSONDecode(body)
    assert(blob.sha == SOURCE_BLOB and blob.encoding == "base64" and type(blob.content) == "string",
        "Toffy: unexpected response for the menu source")
    local source = decodeBase64(blob.content)
    assert(#source == blob.size, "Toffy: menu source size mismatch")
    return source
end

local function importProfiles(previousBrand)
    if not (isfolder and makefolder and listfiles and isfile and readfile and writefile) then
        return
    end
    local marker = BRAND .. "/.profiles-imported.txt"
    if not isfolder(previousBrand) or isfile(marker) then
        return
    end
    if not isfolder(BRAND) then
        makefolder(BRAND)
    end
    for _, entry in listfiles(previousBrand) do
        local name = entry:match("([^/\\]+%.json)$")
        if name then
            local oldPath = previousBrand .. "/" .. name
            local newPath = BRAND .. "/" .. name
            if isfile(oldPath) and not isfile(newPath) then
                writefile(newPath, readfile(oldPath))
            end
        end
    end
    writefile(marker, "1")
end

local function registerImages(encodedImages)
    local assets = {}
    local registerAsset = getcustomasset or getsynasset
    if type(registerAsset) ~= "function" or type(writefile) ~= "function" then
        warn("Toffy mascot: local PNG support is unavailable")
        return assets
    end

    for name, encoded in pairs(encodedImages) do
        local ok, imageUrl = pcall(function()
            local path = PNG_PREFIX .. name .. ".png"
            writefile(path, decodeBase64(encoded))
            local uri = registerAsset(path)
            assert(type(uri) == "string" and uri ~= "", "the local PNG could not be registered")
            return uri
        end)
        if ok then
            assets[name] = imageUrl
        else
            warn("Toffy mascot (" .. name .. "): " .. tostring(imageUrl))
        end
    end
    return assets
end

local function attachDecorations(window, imageUrl)
    local holder = window.Parent
    if not holder then
        return
    end

    local mascot = Instance.new("ImageLabel")
    mascot.Name = "Toffy_Mascot"
    mascot.BackgroundTransparency = 1
    mascot.BorderSizePixel = 0
    mascot.Active = false
    mascot.Interactable = false
    mascot.Selectable = false
    mascot.ZIndex = window.ZIndex + 1
    -- Both sleeve tips are in the left 30 percent of the sprite.
    mascot.AnchorPoint = Vector2.new(0.30, 1)
    mascot.Image = imageUrl or ""

    local credit = Instance.new("TextLabel")
    credit.Name = "Toffy_MenuCredit"
    credit.AutoLocalize = false
    credit.BackgroundTransparency = 1
    credit.Active = false
    credit.Interactable = false
    credit.Selectable = false
    credit.ZIndex = mascot.ZIndex
    credit.AnchorPoint = Vector2.new(1, 1)
    credit.Size = UDim2.fromOffset(116, 18)
    credit.Text = "Menu by Toffy"
    credit.Font = Enum.Font.GothamMedium
    credit.TextSize = 13
    credit.TextXAlignment = Enum.TextXAlignment.Right
    credit.TextColor3 = Color3.fromRGB(213, 225, 241)
    credit.TextStrokeColor3 = Color3.fromRGB(23, 29, 44)

    -- CanvasGroup clips its children, so the decorations share the window's ScreenGui.
    local function sync()
        local visible = window.Parent == holder and window.Visible
        mascot.Visible = visible and imageUrl ~= nil
        credit.Visible = visible
        if not visible then
            return
        end

        local windowWidth = window.AbsoluteSize.X
        local width = math.clamp(windowWidth * 0.22, 84, 164)
        local topLeft = window.AbsolutePosition - holder.AbsolutePosition
        local transparency = window.GroupTransparency
        mascot.Size = UDim2.fromOffset(width, width * ART_ASPECT)
        mascot.Position = UDim2.fromOffset(topLeft.X, topLeft.Y + 3)
        mascot.ImageTransparency = transparency
        credit.Position = UDim2.fromOffset(topLeft.X + windowWidth - 12, topLeft.Y - 5)
        credit.TextTransparency = transparency
        credit.TextStrokeTransparency = 0.55 + transparency * 0.45
    end

    local connections = {
        window:GetPropertyChangedSignal("AbsolutePosition"):Connect(sync),
        window:GetPropertyChangedSignal("AbsoluteSize"):Connect(sync),
        window:GetPropertyChangedSignal("Visible"):Connect(sync),
        window:GetPropertyChangedSignal("GroupTransparency"):Connect(sync),
        window:GetPropertyChangedSignal("Parent"):Connect(sync),
        holder:GetPropertyChangedSignal("AbsolutePosition"):Connect(sync),
        window.Destroying:Once(function()
            mascot:Destroy()
        end),
    }
    mascot.Destroying:Once(function()
        credit:Destroy()
        for _, connection in connections do
            connection:Disconnect()
        end
    end)

    sync()
    mascot.Parent = holder
    credit.Parent = holder
end

local function replaceOnce(source, original, replacement)
    local first, last = source:find(original, 1, true)
    assert(first and not source:find(original, last + 1, true),
        "unexpected source near " .. original)
    return source:sub(1, first - 1) .. replacement .. source:sub(last + 1)
end

local function patchMenu(source, previousBrand)
    local previousLogoName = previousBrand:sub(1, 1) .. previousBrand:sub(2):lower() .. "Logo"
    source = source:gsub(previousBrand, BRAND)
    source = replaceOnce(source, previousLogoName, BRAND .. "Logo")
    source = replaceOnce(source, 'registers[19].Name = "Watermark"', 'registers[19].Name = "Toffy_Watermark"')
    source = replaceOnce(source, 'registers[73].Logo = "90791694090379"', 'registers[73].Logo = ""')
    source = replaceOnce(source, 'registers[7] = "123748867365417"', 'registers[7] = ""')
    source = replaceOnce(source, 'registers[15].Image = "rbxassetid://90791694090379"', [=[registers[15].Image = toffyMascotAssets.Main or ""
            registers[15].ScaleType = environment.Enum.ScaleType.Fit]=])
    local hudTint = [=[registers[1].ImageColor3 = registers[5]
                registers[2] = 396]=]
    source = replaceOnce(source, hudTint, [=[registers[1].ImageColor3 = toffyMascotAssets.Main and environment.Color3.new(1, 1, 1) or registers[5]
                registers[2] = 396]=])

    local count
    source, count = source:gsub(
        "(return 1)(%s+end%s+return bindEnvironment%(runMM2, environment, deferEnvironment%))",
        "%1, registers[515].Window.Items.MainFrame.Instance%2", 1)
    assert(count == 1, "the menu attachment point was not found")

    -- These are the header logo and the sidebar profile image.
    source = replaceOnce(source, "registers[25].Image = registers[9]", 'registers[25].Image = toffyMascotAssets.Main or ""')
    source = replaceOnce(source, "registers[3].Image = registers[24]", "registers[3].Image = toffyMascotAssets.Main or registers[24]")
    local logoTheme = [=[registers[1].ImageColor3 = "Image"
        registers[28](registers[29], registers[1])
        registers[8] = 251]=]
    source = replaceOnce(source, logoTheme,
        logoTheme:gsub('"Image"', 'toffyMascotAssets.Main and environment.Color3.new(1, 1, 1) or "Image"', 1))
    -- Only the glow under the sidebar logo is hidden.
    source = replaceOnce(source, "registers[25].ImageTransparency = 0.62", "registers[25].ImageTransparency = 1")

    local defaultTheme = "registers[437].Default = registers[9]"
    source = replaceOnce(source, defaultTheme, defaultTheme .. [=[

        do
            local theme = registers[437].Default
            local rgb = environment.Color3.fromRGB
            theme.Background = rgb(23, 29, 44)
            theme.Inline = rgb(32, 40, 59)
            theme.Element = rgb(40, 52, 75)
            theme.Text = rgb(244, 239, 249)
            theme.Image = rgb(213, 225, 241)
            theme.Accent = rgb(140, 193, 228)
            theme["Light Accent"] = rgb(240, 168, 203)
            theme.Border = rgb(75, 88, 117)
        end]=])

    -- The custom-avatar provider is separate from the real Roblox player thumbnails.
    local avatarLoader = "local function function_9577(...)"
    source = replaceOnce(source, avatarLoader, avatarLoader .. [[

        if toffyMascotAssets.Main then
            return toffyMascotAssets.Main
        end]])
    for _, image in { "upvalues[3]", "upvalues[4]" } do
        local anchor = image .. ".Image = value_2"
        source = replaceOnce(source, anchor, anchor .. ([=[

            %s.ScaleType = if toffyMascotAssets.Main == value_2 and value_2 ~= nil
                then environment.Enum.ScaleType.Fit else environment.Enum.ScaleType.Crop]=]):format(image))
    end

    -- Supply images in the exact layouts the existing Meow modes expect.
    for _, mode in {
        { factory = "4861", asset = "Mimi" },
        { factory = "5658", asset = "Protogen" },
        { factory = "7594", asset = "Main" },
        { factory = "10012", asset = "Furry" },
    } do
        local anchor = "local function function_" .. mode.factory .. "(...)"
        local replacement = anchor .. ([=[

        if toffyMascotAssets.%s then
            local image = upvalues[1]
            image[6][image[3]] = toffyMascotAssets.%s
            return
        end]=]):format(mode.asset, mode.asset)
        source = replaceOnce(source, anchor, replacement)
    end
    return "local toffyMascotAssets = ...\n" .. source
end

local function run(encodedImages)
    local source = fetchSource()
    local previousBrand = assert(source:match('environment%.configFolder = "([A-Z]+)"'),
        "Toffy: could not identify the previous menu namespace")
    local menu = assert(loadstring(patchMenu(source, previousBrand)))
    local imported, importError = pcall(importProfiles, previousBrand)
    if not imported then
        warn("Toffy profile import: " .. tostring(importError))
    end

    local assets = registerImages(encodedImages)
    local result, window = menu(assets)
    if window then
        local ok, failure = pcall(attachDecorations, window, assets.Main)
        if not ok then
            warn("Toffy mascot: " .. tostring(failure))
        end
    end
    return result
end

